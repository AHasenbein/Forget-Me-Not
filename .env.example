# Copy to .env. Never commit .env. Per-feature vars are prefixed with the feature name
# (e.g. GIFT_CARD_GUARD_*) and validated at startup by core/config/env.ts.
NODE_ENV=development
# demo = canned fictional data + mock adapters (default outside production). live = real adapters.
# Per-service override: DATA_MODE_AI | DATA_MODE_PLAID | DATA_MODE_NOTIFIER | DATA_MODE_LOCATION = demo|live
DATA_MODE=demo
EXPO_PUBLIC_DATA_MODE=demo           # what the mobile app reads (inlined at build time)
# ALLOW_DEMO_IN_PRODUCTION=true      # required to run demo mode with NODE_ENV=production (e.g. a hosted demo)
# FEATURE_ALL=on                     # turn on every feature that isn't explicitly FEATURE_<NAME>=off
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only, never ship in the app bundle
SUPABASE_PROJECT_REF=                # project ref (dashboard URL); used by `supabase link` and CI
SUPABASE_DB_PASSWORD=                # database password; used by `supabase db push`, never commit
SUPABASE_ACCESS_TOKEN=               # personal access token (dashboard > Account > Access Tokens); CLI + CI only
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
AI_API_KEY=                          # real pill photo checks (DATA_MODE_VISION=live); tests use core/testing mocks
OPENROUTER_API_KEY=                  # real call analysis (DATA_MODE_AI=live), via OpenRouter
OPENROUTER_MODEL=                    # optional OpenRouter model id; default openai/gpt-4o-mini
PLAID_ENV=sandbox                    # sandbox ONLY
PLAID_CLIENT_ID=
PLAID_SECRET=
CALL_RECORDING_ENABLED=false         # consent/jurisdiction flag; default off
# Live sign-in test users (npm run seed:live). Emails are fictional; the password lives ONLY in your .env.
SEED_PASSWORD=                       # >= 12 characters, shared by the four test accounts
# QUICK_LOGIN=on                     # DEV ONLY: server-side switch for the pick-an-account sign-in (dev:api:live sets it; localhost only)
# CORS_ORIGINS=http://localhost:8081 # live API: browser origins allowed to call it (comma-separated)
# EXPO_PUBLIC_API_URL=http://localhost:8787
# EXPO_PUBLIC_FEATURE_ALL=on         # live app: show every feature (client-side flags)
# Feature flags: FEATURE_<NAME>=on|off (unset = manifest default, new features default off)
# FEATURE_FRIENDS_FAMILY=off
