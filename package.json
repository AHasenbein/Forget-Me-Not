{
  "name": "forget-me-not",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npm ci && npm run gen:registry && tsx scripts/setup.ts",
    "prepare": "husky",
    "dev": "npm run gen:registry && expo start --dev-client",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "dev:demo": "cross-env DATA_MODE=demo EXPO_PUBLIC_DATA_MODE=demo FEATURE_ALL=on npm run dev",
    "dev:live": "cross-env DATA_MODE=live EXPO_PUBLIC_DATA_MODE=live EXPO_PUBLIC_FEATURE_ALL=on EXPO_PUBLIC_QUICK_LOGIN=on npm run dev",
    "dev:api:demo": "cross-env DATA_MODE=demo FEATURE_ALL=on npm run dev:api",
    "dev:api:live": "cross-env DATA_MODE=live DATA_MODE_AI=demo DATA_MODE_VISION=demo DATA_MODE_PLAID=demo DATA_MODE_NOTIFIER=demo DATA_MODE_LOCATION=demo FEATURE_ALL=on QUICK_LOGIN=on node --env-file=.env --import tsx scripts/dev-api.ts",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run --project unit",
    "integration": "vitest run --project integration",
    "test": "vitest run --project unit --project integration",
    "boundary": "vitest run tests/architecture",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --project unit --project integration --coverage",
    "build": "npm run gen:registry && expo export --platform web --output-dir dist",
    "audit:deps": "npm audit --audit-level=critical --omit=dev",
    "new-feature": "tsx scripts/new-feature.ts",
    "sync-migrations": "tsx scripts/sync-migrations.ts",
    "db:push:dry": "npm run sync-migrations && npx supabase db push --dry-run --linked",
    "db:push": "npm run sync-migrations && npx supabase db push --linked",
    "db:probe": "node --env-file=.env --import tsx scripts/probe-rls.ts",
    "test:store:live": "cross-env REMINDERS_TEST_SUPABASE=1 node --env-file=.env node_modules/vitest/vitest.mjs run features/reminders/tests/unit/store-supabase.test.ts",
    "seed:live": "node --env-file=.env --import tsx scripts/seed-live-users.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings 0 --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@expo/metro-runtime": "~57.0.17",
    "@hono/node-server": "^2.1.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "^57.0.31",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-video": "~57.0.5",
    "hono": "^4.13.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "node-forge": "^1.4.0",
    "decode-uri-component": "^0.5.1"
  }
}
