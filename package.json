{
  "name": "forget-me-not",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npm ci && npm run gen:registry && echo 'Setup done. Next: cp .env.example .env && npm run dev'",
    "prepare": "husky || true",
    "dev": "npm run gen:registry && expo start --dev-client",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "dev:demo": "DATA_MODE=demo EXPO_PUBLIC_DATA_MODE=demo FEATURE_ALL=on npm run dev",
    "dev:live": "DATA_MODE=live EXPO_PUBLIC_DATA_MODE=live npm run dev",
    "dev:api:demo": "DATA_MODE=demo FEATURE_ALL=on npm run dev:api",
    "dev:api:live": "DATA_MODE=live npm run dev:api",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run --project unit",
    "integration": "vitest run --project integration",
    "test": "vitest run --project unit --project integration",
    "boundary": "vitest run tests/architecture",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --project unit --project integration --coverage",
    "build": "npm run gen:registry && expo export --platform web --output-dir dist",
    "audit:deps": "npm audit --audit-level=critical --omit=dev",
    "new-feature": "tsx scripts/new-feature.ts",
    "sync-migrations": "tsx scripts/sync-migrations.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings 0 --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@hono/node-server": "^2.1.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "^57.0.31",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-video": "~57.0.5",
    "hono": "^4.13.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
